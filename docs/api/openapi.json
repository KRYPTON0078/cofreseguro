  "components": {
    "schemas": {
      "AnalyzeIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AnalyzeIn"
      },
      "AnalyzeOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "risk_score": {
            "type": "number",
            "title": "Risk Score"
          },
          "risk_level": {
            "type": "string",
            "title": "Risk Level"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Labels"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "tip": {
            "type": "string",
            "title": "Tip"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "url_scores": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Url Scores"
          },
          "engine_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Engine Scores",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "id",
          "risk_score",
          "risk_level",
          "labels",
          "explanation",
          "tip",
          "engine",
          "url_scores"
        ],
        "title": "AnalyzeOut"
      },
      "Body_analyze_image_v1_analyze_image_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_image_v1_analyze_image_post"
      },
      "ChangePasswordIn": {
        "properties": {
          "current_password": {
            "type": "string",
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordIn"
      },
      "FeedbackIn": {
        "properties": {
          "analysis_id": {
            "type": "integer",
            "title": "Analysis Id"
          },
          "verdict": {
            "type": "string",
            "pattern": "^(false_positive|false_negative|correct)$",
            "title": "Verdict"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "verdict"
        ],
        "title": "FeedbackIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "RefreshIn": {
        "properties": {
